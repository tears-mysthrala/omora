# Changes require a restart to take effect.

# Ensure Omora bins are in the path while keeping Omarchy compatibility.
if [ -d "$HOME/.local/share/omora" ]; then
  export OMORA_PATH="${OMORA_PATH:-$HOME/.local/share/omora}"
else
  export OMORA_PATH="${OMORA_PATH:-$HOME/.local/share/omarchy}"
fi
export OMARCHY_PATH="${OMARCHY_PATH:-$OMORA_PATH}"
export PATH=$OMORA_PATH/bin:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
omarchy-cmd-present mise && eval "$(mise activate bash --shims)"
