#!/bin/bash

# Ensure we have the omarchy GPG key imported for the custom repo
OMARCHY_KEY="40DFB630FF42BCFFB047046CF0134EE680CAC571"

if ! rpm -qa gpg-pubkey* | grep -qi "${OMARCHY_KEY:(-8)}"; then
  echo -e "\e[32m\nImporting Omarchy signing key\e[0m"
  sudo rpm --import "https://keys.openpgp.org/vks/v1/by-fingerprint/$OMARCHY_KEY"
fi

# Ensure we have the latest Fedora GPG keys
echo -e "\e[32m\nUpdate Fedora signing keys\e[0m"
sudo dnf install -y fedora-gpg-keys >/dev/null
