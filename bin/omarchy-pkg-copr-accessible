#!/bin/bash

# Returns true if the COPR service is up and available.
# Used by omarchy-update-system-pkgs to ensure COPR is available before updating packages from it.

curl -sf --connect-timeout 30 --retry 3 --retry-delay 3 -A "omarchy-update" \
  "https://copr.fedorainfracloud.org/api_3/project?ownername=omarchy" >/dev/null
