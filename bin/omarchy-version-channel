#!/bin/bash

if [[ -f /etc/yum.repos.d/omarchy.repo ]]; then
  if grep -q "pkgs.omarchy.org/stable/" /etc/yum.repos.d/omarchy.repo; then
    echo "stable"
  elif grep -q "pkgs.omarchy.org/rc/" /etc/yum.repos.d/omarchy.repo; then
    echo "rc"
  elif grep -q "pkgs.omarchy.org/edge/" /etc/yum.repos.d/omarchy.repo; then
    echo "edge"
  else
    echo "unknown"
  fi
else
  echo "unknown"
fi
