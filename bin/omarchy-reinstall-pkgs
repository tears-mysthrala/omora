#!/bin/bash
set -e

# Reinstall all default Omarchy packages from the stable channel and sync any packages that are too new.

# Set the package repository to the stable repos
omarchy-refresh-repos

# Sync all packages to the stable versions
sudo dnf distro-sync -y

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMARCHY_PATH/install/omarchy-base.packages" | grep -v '^$')
sudo dnf install -y "${packages[@]}"
