#!/bin/bash

# Show a fuzzy-finder TUI for picking new COPR packages to install.
# On Fedora, COPR packages are available via dnf once the repo is enabled.

fzf_args=(
  --multi
  --preview 'dnf info {1} 2>/dev/null'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(dnf list available --quiet 2>/dev/null | tail -n +2 | awk '{print $1}' | sed 's/\..*//' | sort -u | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  sudo -v
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo dnf install -y
  sudo updatedb
  omarchy-show-done
fi
